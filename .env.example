# ---------------------------------------------------------------------------
# Copy to `.env` and adjust for your server. Never commit the real .env file.
# ---------------------------------------------------------------------------
APP_ENV=local
APP_DEBUG=false
APP_TIMEZONE=Asia/Tehran
# Public base URL, e.g. https://monochi.ir or http://127.0.0.1:8091/digital-menu-latest
APP_URL=
# 32+ random characters. Used to sign URLs and hash request metadata.
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=digital_menu
DB_USER=root
DB_PASS=

SESSION_NAME=MONOCHISESS
SESSION_IDLE=1800
SESSION_ABSOLUTE=43200

# Behind a reverse proxy set this to the proxy IPs (comma separated) so the
# real client address can be used for rate limiting. Leave empty otherwise.
TRUSTED_PROXIES=
